<div class="app-bg">
  <header class="topbar">
    <div>
      <p class="topbar-kicker">W-Core Desafio</p>
      <h1 class="topbar-title">Planta 42</h1>
    </div>
    <div class="topbar-actions">
      <.link :if={@current_user} class="btn btn-secondary" navigate={~p"/dashboard"}>
        Dashboard
      </.link>
      <%= if @current_user do %>
        <span class="user-pill"><%= @current_user.email %></span>
        <form action={~p"/users/log_out"} method="post">
          <input type="hidden" name="_method" value="delete" />
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <button class="btn btn-secondary" type="submit">Sair</button>
        </form>
      <% else %>
        <.link class="btn btn-secondary" navigate={~p"/users/log_in"}>Entrar</.link>
      <% end %>
    </div>
  </header>

  <main class="app-main">
    <div id="flash-group" class="flash-group">
      <p :for={{kind, message} <- @flash} :if={kind in [:info, :error] and message not in [nil, ""]} class={["flash-message", "flash-#{kind}"]}>
        <%= message %>
      </p>
    </div>
    <div class="surface-shell">
      <%= @inner_content %>
    </div>
  </main>
</div>
